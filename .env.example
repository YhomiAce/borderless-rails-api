NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://borderless:borderless@localhost:5434/borderless
RUN_MIGRATIONS=true
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_TIMEOUT_MS=3000
FX_REFRESH_INTERVAL_MS=600000
FX_MAX_STALENESS_MS=129600000

RABBITMQ_URL=amqp://borderless:borderless@localhost:5672
RABBITMQ_EXCHANGE=borderless.events
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
EVENTS_LOGGER_ENABLED=true
EVENTS_LOGGER_QUEUE=borderless.events-logger
EVENTS_LOGGER_BINDING=#
